---- MODULE MC_TTrace_1794187164 ----
EXTENDS Sequences, TLCExt, MC, Toolbox, Naturals, TLC, MC_TEConstants

_expression ==
    LET MC_TEExpression == INSTANCE MC_TEExpression
    IN MC_TEExpression!expression
----

_trace ==
    LET MC_TETrace == INSTANCE MC_TETrace
    IN MC_TETrace!trace
----

_inv ==
    ~(
        TLCGet("level") = Len(_TETrace)
        /\
        cache = ((j0 :> 2 @@ j1 :> 1 @@ j2 :> 1))
        /\
        wEpoch = (<<-1, -1, 1>>)
        /\
        wRnd = (<<0, 0, 3>>)
        /\
        targetFired = (TRUE)
        /\
        prev = ((j0 :> [promise |-> -1, seg |-> FALSE] @@ j1 :> [promise |-> -1, seg |-> FALSE] @@ j2 :> [promise |-> -1, seg |-> FALSE]))
        /\
        wCand = (<<1, 2, 1>>)
        /\
        wSeg = (<<0, 0, 1>>)
        /\
        faults = ([loss |-> 2, stop |-> 2, restart |-> 0, upgrade |-> 0, rollback |-> 0])
        /\
        disk = ((j0 :> 2 @@ j1 :> 1 @@ j2 :> 1))
        /\
        wResp = (<<(j0 :> "none" @@ j1 :> "none" @@ j2 :> "none"), (j0 :> "none" @@ j1 :> "none" @@ j2 :> "none"), (j0 :> "none" @@ j1 :> "none" @@ j2 :> "none")>>)
        /\
        wst = (<<"stopped", "stopped", "sls">>)
        /\
        rep = (<<(j0 :> [kind |-> "none", rnd |-> 0, ok |-> FALSE, val |-> -1] @@ j1 :> [kind |-> "none", rnd |-> 0, ok |-> FALSE, val |-> -1] @@ j2 :> [kind |-> "none", rnd |-> 0, ok |-> FALSE, val |-> -1]), (j0 :> [kind |-> "none", rnd |-> 0, ok |-> FALSE, val |-> -1] @@ j1 :> [kind |-> "none", rnd |-> 0, ok |-> FALSE, val |-> -1] @@ j2 :> [kind |-> "none", rnd |-> 0, ok |-> FALSE, val |-> -1]), (j0 :> [kind |-> "SLS", rnd |-> 3, ok |-> FALSE, val |-> -1] @@ j1 :> [kind |-> "none", rnd |-> 0, ok |-> FALSE, val |-> -1] @@ j2 :> [kind |-> "none", rnd |-> 0, ok |-> FALSE, val |-> -1])>>)
        /\
        chan = (<<(j0 :> <<>> @@ j1 :> <<>> @@ j2 :> <<>>), (j0 :> <<>> @@ j1 :> <<>> @@ j2 :> <<>>), (j0 :> <<>> @@ j1 :> <<[kind |-> "SLS", rnd |-> 3, epoch |-> 1]>> @@ j2 :> <<[kind |-> "SLS", rnd |-> 3, epoch |-> 1]>>)>>)
        /\
        wVal = (<<(j0 :> -1 @@ j1 :> -1 @@ j2 :> -1), (j0 :> -1 @@ j1 :> -1 @@ j2 :> -1), (j0 :> -1 @@ j1 :> -1 @@ j2 :> -1)>>)
        /\
        hasSeg = ((j0 :> FALSE @@ j1 :> FALSE @@ j2 :> FALSE))
    )
----

_init ==
    /\ wRnd = _TETrace[1].wRnd
    /\ wVal = _TETrace[1].wVal
    /\ targetFired = _TETrace[1].targetFired
    /\ wst = _TETrace[1].wst
    /\ prev = _TETrace[1].prev
    /\ wEpoch = _TETrace[1].wEpoch
    /\ hasSeg = _TETrace[1].hasSeg
    /\ disk = _TETrace[1].disk
    /\ faults = _TETrace[1].faults
    /\ rep = _TETrace[1].rep
    /\ wCand = _TETrace[1].wCand
    /\ chan = _TETrace[1].chan
    /\ wResp = _TETrace[1].wResp
    /\ wSeg = _TETrace[1].wSeg
    /\ cache = _TETrace[1].cache
----

_next ==
    /\ \E i,j \in DOMAIN _TETrace:
        /\ \/ /\ j = i + 1
              /\ i = TLCGet("level")
        /\ wRnd  = _TETrace[i].wRnd
        /\ wRnd' = _TETrace[j].wRnd
        /\ wVal  = _TETrace[i].wVal
        /\ wVal' = _TETrace[j].wVal
        /\ targetFired  = _TETrace[i].targetFired
        /\ targetFired' = _TETrace[j].targetFired
        /\ wst  = _TETrace[i].wst
        /\ wst' = _TETrace[j].wst
        /\ prev  = _TETrace[i].prev
        /\ prev' = _TETrace[j].prev
        /\ wEpoch  = _TETrace[i].wEpoch
        /\ wEpoch' = _TETrace[j].wEpoch
        /\ hasSeg  = _TETrace[i].hasSeg
        /\ hasSeg' = _TETrace[j].hasSeg
        /\ disk  = _TETrace[i].disk
        /\ disk' = _TETrace[j].disk
        /\ faults  = _TETrace[i].faults
        /\ faults' = _TETrace[j].faults
        /\ rep  = _TETrace[i].rep
        /\ rep' = _TETrace[j].rep
        /\ wCand  = _TETrace[i].wCand
        /\ wCand' = _TETrace[j].wCand
        /\ chan  = _TETrace[i].chan
        /\ chan' = _TETrace[j].chan
        /\ wResp  = _TETrace[i].wResp
        /\ wResp' = _TETrace[j].wResp
        /\ wSeg  = _TETrace[i].wSeg
        /\ wSeg' = _TETrace[j].wSeg
        /\ cache  = _TETrace[i].cache
        /\ cache' = _TETrace[j].cache

\* Uncomment the ASSUME below to write the states of the error trace
\* to the given file in Json format. Note that you can pass any tuple
\* to `JsonSerialize`. For example, a sub-sequence of _TETrace.
    \* ASSUME
    \*     LET J == INSTANCE Json
    \*         IN J!JsonSerialize("MC_TTrace_1794187164.json", _TETrace)

=============================================================================

 Note that you can extract this module `MC_TEExpression`
  to a dedicated file to reuse `expression` (the module in the 
  dedicated `MC_TEExpression.tla` file takes precedence 
  over the module `MC_TEExpression` below).

---- MODULE MC_TEExpression ----
EXTENDS Sequences, TLCExt, MC, Toolbox, Naturals, TLC, MC_TEConstants

expression == 
    [
        \* To hide variables of the `MC` spec from the error trace,
        \* remove the variables below.  The trace will be written in the order
        \* of the fields of this record.
        wRnd |-> wRnd
        ,wVal |-> wVal
        ,targetFired |-> targetFired
        ,wst |-> wst
        ,prev |-> prev
        ,wEpoch |-> wEpoch
        ,hasSeg |-> hasSeg
        ,disk |-> disk
        ,faults |-> faults
        ,rep |-> rep
        ,wCand |-> wCand
        ,chan |-> chan
        ,wResp |-> wResp
        ,wSeg |-> wSeg
        ,cache |-> cache
        
        \* Put additional constant-, state-, and action-level expressions here:
        \* ,_stateNumber |-> _TEPosition
        \* ,_wRndUnchanged |-> wRnd = wRnd'
        
        \* Format the `wRnd` variable as Json value.
        \* ,_wRndJson |->
        \*     LET J == INSTANCE Json
        \*     IN J!ToJson(wRnd)
        
        \* Lastly, you may build expressions over arbitrary sets of states by
        \* leveraging the _TETrace operator.  For example, this is how to
        \* count the number of times a spec variable changed up to the current
        \* state in the trace.
        \* ,_wRndModCount |->
        \*     LET F[s \in DOMAIN _TETrace] ==
        \*         IF s = 1 THEN 0
        \*         ELSE IF _TETrace[s].wRnd # _TETrace[s-1].wRnd
        \*             THEN 1 + F[s-1] ELSE F[s-1]
        \*     IN F[_TEPosition - 1]
    ]

=============================================================================



Parsing and semantic processing can take forever if the trace below is long.
 In this case, it is advised to uncomment the module below to deserialize the
 trace from a generated binary file.

\*
\*---- MODULE MC_TETrace ----
\*EXTENDS IOUtils, MC, TLC, MC_TEConstants
\*
\*trace == IODeserialize("MC_TTrace_1794187164.bin", TRUE)
\*
\*=============================================================================
\*

---- MODULE MC_TETrace ----
EXTENDS MC, TLC, MC_TEConstants

