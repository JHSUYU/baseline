--- source lines 484-494 of Journal.java at 734dd8a67cd ---
484	  private synchronized void checkRequest(RequestInfo reqInfo) throws IOException {
485	    // Invariant 25 from ZAB paper
486	    if (reqInfo.getEpoch() < lastPromisedEpoch.get()) {
487	      throw new IOException("IPC's epoch " + reqInfo.getEpoch() +
488	          " is less than the last promised epoch " +
489	          lastPromisedEpoch.get() + " ; journal id: " + journalId);
490	    } else if (reqInfo.getEpoch() > lastPromisedEpoch.get()) {
491	      // A newer client has arrived. Fence any previous writers by updating
492	      // the promise.
493	      updateLastPromisedEpoch(reqInfo.getEpoch());
494	    }
