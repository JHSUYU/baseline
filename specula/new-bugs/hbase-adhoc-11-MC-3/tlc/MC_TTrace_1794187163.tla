---- MODULE MC_TTrace_1794187163 ----
EXTENDS Sequences, TLCExt, MC, Toolbox, Naturals, TLC, MC_TEConstants

_expression ==
    LET MC_TEExpression == INSTANCE MC_TEExpression
    IN MC_TEExpression!expression
----

_trace ==
    LET MC_TETrace == INSTANCE MC_TETrace
    IN MC_TETrace!trace
----

_inv ==
    ~(
        TLCGet("level") = Len(_TETrace)
        /\
        targetFired = (TRUE)
        /\
        rrpb = (<<[parent |-> 0, region |-> r1, st |-> "NONE", kind |-> "OPEN", target |-> NoServer, sent |-> FALSE], [parent |-> 0, region |-> r1, st |-> "NONE", kind |-> "OPEN", target |-> NoServer, sent |-> FALSE], [parent |-> 0, region |-> r1, st |-> "NONE", kind |-> "OPEN", target |-> NoServer, sent |-> FALSE], [parent |-> 3, region |-> r1, st |-> "DONE", kind |-> "CLOSE", target |-> s1, sent |-> TRUE], [parent |-> 0, region |-> r1, st |-> "NONE", kind |-> "OPEN", target |-> NoServer, sent |-> FALSE], [parent |-> 5, region |-> r1, st |-> "DONE", kind |-> "OPEN", target |-> s1, sent |-> TRUE], [parent |-> 2, region |-> r1, st |-> "DISPATCH", kind |-> "CLOSE", target |-> s1, sent |-> FALSE], [parent |-> 0, region |-> r1, st |-> "NONE", kind |-> "OPEN", target |-> NoServer, sent |-> FALSE], [parent |-> 0, region |-> r1, st |-> "NONE", kind |-> "OPEN", target |-> NoServer, sent |-> FALSE], [parent |-> 0, region |-> r1, st |-> "NONE", kind |-> "OPEN", target |-> NoServer, sent |-> FALSE], [parent |-> 0, region |-> r1, st |-> "NONE", kind |-> "OPEN", target |-> NoServer, sent |-> FALSE], [parent |-> 0, region |-> r1, st |-> "NONE", kind |-> "OPEN", target |-> NoServer, sent |-> FALSE], [parent |-> 0, region |-> r1, st |-> "NONE", kind |-> "OPEN", target |-> NoServer, sent |-> FALSE], [parent |-> 0, region |-> r1, st |-> "NONE", kind |-> "OPEN", target |-> NoServer, sent |-> FALSE]>>)
        /\
        rsg = ([st |-> "none", todo |-> <<>>, server |-> NoServer, failed |-> {}, retry |-> 0, waiting |-> {}])
        /\
        tableState = ("ENABLED")
        /\
        metaLoc = ((r1 :> s1))
        /\
        opWait = ([kind |-> "idle", pid |-> 0])
        /\
        faults = ([ops |-> 1, disables |-> 0, splits |-> 0, aborts |-> 0, preOpFails |-> 0, truncates |-> 1, balPlans |-> 1, crashes |-> 0, failovers |-> 0, decoms |-> 0, rsgs |-> 0, rpcFails |-> 0])
        /\
        nextPid = (8)
        /\
        ssn = ((s1 :> {r1} @@ s2 :> {}))
        /\
        decom = ([st |-> "none", todo |-> <<>>, server |-> NoServer, dests |-> {}])
        /\
        serverState = ((s1 :> "ONLINE" @@ s2 :> "ONLINE"))
        /\
        split = ([region |-> r1, child |-> 0, st |-> "none", pid |-> 0, stack |-> <<>>, execs |-> 0, aborted |-> FALSE])
        /\
        balPlan = ([region |-> r1, st |-> "none", src |-> NoServer, dest |-> NoServer])
        /\
        metaState = ((r1 :> "CLOSING"))
        /\
        draining = ({})
        /\
        schedLock = ((r1 :> 2))
        /\
        metaSplitParent = ((r1 :> FALSE))
        /\
        msgs = ({})
        /\
        scp = ((s1 :> [st |-> "none", pid |-> 0, todo |-> {}, children |-> {}] @@ s2 :> [st |-> "none", pid |-> 0, todo |-> {}, children |-> {}]))
        /\
        rsnLoc = ((r1 :> s1))
        /\
        lastHost = ((r1 :> s1))
        /\
        rsnState = ((r1 :> "CLOSING"))
        /\
        rsRegions = ((s1 :> {r1} @@ s2 :> {}))
        /\
        trsp = (<<[pc |-> "NONE", parent |-> 0, region |-> r1, type |-> "ASSIGN", force |-> FALSE, cand |-> NoServer, child |-> 0, waitAssign |-> FALSE], [pc |-> "CONFIRM_CLOSED", parent |-> 0, region |-> r1, type |-> "MOVE", force |-> FALSE, cand |-> s2, child |-> 7, waitAssign |-> FALSE], [pc |-> "DONE", parent |-> 1, region |-> r1, type |-> "UNASSIGN", force |-> FALSE, cand |-> NoServer, child |-> 0, waitAssign |-> FALSE], [pc |-> "NONE", parent |-> 0, region |-> r1, type |-> "ASSIGN", force |-> FALSE, cand |-> NoServer, child |-> 0, waitAssign |-> FALSE], [pc |-> "DONE", parent |-> 1, region |-> r1, type |-> "ASSIGN", force |-> FALSE, cand |-> NoServer, child |-> 0, waitAssign |-> FALSE], [pc |-> "NONE", parent |-> 0, region |-> r1, type |-> "ASSIGN", force |-> FALSE, cand |-> NoServer, child |-> 0, waitAssign |-> FALSE], [pc |-> "NONE", parent |-> 0, region |-> r1, type |-> "ASSIGN", force |-> FALSE, cand |-> NoServer, child |-> 0, waitAssign |-> FALSE], [pc |-> "NONE", parent |-> 0, region |-> r1, type |-> "ASSIGN", force |-> FALSE, cand |-> NoServer, child |-> 0, waitAssign |-> FALSE], [pc |-> "NONE", parent |-> 0, region |-> r1, type |-> "ASSIGN", force |-> FALSE, cand |-> NoServer, child |-> 0, waitAssign |-> FALSE], [pc |-> "NONE", parent |-> 0, region |-> r1, type |-> "ASSIGN", force |-> FALSE, cand |-> NoServer, child |-> 0, waitAssign |-> FALSE], [pc |-> "NONE", parent |-> 0, region |-> r1, type |-> "ASSIGN", force |-> FALSE, cand |-> NoServer, child |-> 0, waitAssign |-> FALSE], [pc |-> "NONE", parent |-> 0, region |-> r1, type |-> "ASSIGN", force |-> FALSE, cand |-> NoServer, child |-> 0, waitAssign |-> FALSE], [pc |-> "NONE", parent |-> 0, region |-> r1, type |-> "ASSIGN", force |-> FALSE, cand |-> NoServer, child |-> 0, waitAssign |-> FALSE], [pc |-> "NONE", parent |-> 0, region |-> r1, type |-> "ASSIGN", force |-> FALSE, cand |-> NoServer, child |-> 0, waitAssign |-> FALSE]>>)
        /\
        trunc = ([region |-> r1, child |-> 5, st |-> "done", pid |-> 1])
        /\
        rsnProc = ((r1 :> 0))
        /\
        disable = ([st |-> "none", pid |-> 0, children |-> {}])
        /\
        rsOnline = ((s1 :> TRUE @@ s2 :> TRUE))
        /\
        activeTrspCount = (0)
