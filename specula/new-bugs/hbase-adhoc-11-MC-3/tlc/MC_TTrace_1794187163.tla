_next ==
    /\ \E i,j \in DOMAIN _TETrace:
        /\ \/ /\ j = i + 1
              /\ i = TLCGet("level")
        /\ trunc  = _TETrace[i].trunc
        /\ trunc' = _TETrace[j].trunc
        /\ metaLoc  = _TETrace[i].metaLoc
        /\ metaLoc' = _TETrace[j].metaLoc
        /\ msgs  = _TETrace[i].msgs
        /\ msgs' = _TETrace[j].msgs
