---- MODULE MC_TTrace_1793567993 ----
EXTENDS Sequences, TLCExt, MC, Toolbox, Naturals, TLC, MC_TEConstants

_expression ==
    LET MC_TEExpression == INSTANCE MC_TEExpression
    IN MC_TEExpression!expression
----

_trace ==
    LET MC_TETrace == INSTANCE MC_TETrace
    IN MC_TETrace!trace
----

_inv ==
    ~(
        TLCGet("level") = Len(_TETrace)
        /\
        wEpoch = (<<1>>)
        /\
        jn = ((j1 :> [serial |-> 1, committed |-> -12345, promised |-> 1, lwMem |-> 0, lwDisk |-> 0, lwPrev |-> 0, curSeg |-> -12345, nextTx |-> -12345, files |-> <<[st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0]>>] @@ j2 :> [serial |-> 0, committed |-> -12345, promised |-> 1, lwMem |-> 1, lwDisk |-> 1, lwPrev |-> 0, curSeg |-> 1, nextTx |-> 1, files |-> <<[st |-> "inprog", last |-> -12345], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0]>>] @@ j3 :> [serial |-> 0, committed |-> -12345, promised |-> 1, lwMem |-> 1, lwDisk |-> 1, lwPrev |-> 0, curSeg |-> 1, nextTx |-> 1, files |-> <<[st |-> "inprog", last |-> -12345], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0], [st |-> "none", last |-> 0]>>]))
        /\
        targetFired = (TRUE)
        /\
        wSeg = (<<1>>)
        /\
        wPhase = (<<"wait">>)
        /\
        chQ = (<<(j1 :> <<>> @@ j2 :> <<[op |-> "journal", a1 |-> 1, a2 |-> 1, a3 |-> 3, cid |-> 4]>> @@ j3 :> <<[op |-> "journal", a1 |-> 1, a2 |-> 1, a3 |-> 3, cid |-> 4]>>)>>)
        /\
        faults = ([lost |-> 0, crash |-> 1, wcrash |-> 0, late |-> 0, disk |-> 0])
        /\
        wRec = (<<[seg |-> 0, end |-> 0]>>)
        /\
        inflight = (<<(j1 :> [w |-> 0, op |-> "none", a1 |-> 0, a2 |-> 0, a3 |-> 0, cid |-> 0, epoch |-> 0, serial |-> -1, committed |-> -12345, st |-> "none"] @@ j2 :> [w |-> 0, op |-> "none", a1 |-> 0, a2 |-> 0, a3 |-> 0, cid |-> 0, epoch |-> 0, serial |-> -1, committed |-> -12345, st |-> "none"] @@ j3 :> [w |-> 0, op |-> "none", a1 |-> 0, a2 |-> 0, a3 |-> 0, cid |-> 0, epoch |-> 0, serial |-> -1, committed |-> -12345, st |-> "none"])>>)
        /\
        wCid = (<<4>>)
        /\
        wCommitted = (<<-12345>>)
        /\
        nextSerial = (<<(j1 :> 2 @@ j2 :> 1 @@ j3 :> 1)>>)
        /\
        wOp = (<<[op |-> "journal", a1 |-> 1, a2 |-> 1, a3 |-> 3, cid |-> 0]>>)
        /\
        up = ((j1 :> TRUE @@ j2 :> TRUE @@ j3 :> TRUE))
        /\
        srvPend = ((j1 :> {} @@ j2 :> {} @@ j3 :> {}))
        /\
        outOfSync = (<<(j1 :> TRUE @@ j2 :> FALSE @@ j3 :> FALSE)>>)
        /\
        wRes = (<<(j1 :> [committed |-> -12345, st |-> "err", promised |-> 0, lastSeg |-> 0, hasSeg |-> FALSE, segLast |-> 0, segInProg |-> FALSE, lwe |-> 0] @@ j2 :> [committed |-> -12345, st |-> "pending", promised |-> 0, lastSeg |-> 0, hasSeg |-> FALSE, segLast |-> 0, segInProg |-> FALSE, lwe |-> 0] @@ j3 :> [committed |-> -12345, st |-> "pending", promised |-> 0, lastSeg |-> 0, hasSeg |-> FALSE, segLast |-> 0, segInProg |-> FALSE, lwe |-> 0])>>)
    )
----

_init ==
    /\ chQ = _TETrace[1].chQ
    /\ wCid = _TETrace[1].wCid
    /\ targetFired = _TETrace[1].targetFired
    /\ wOp = _TETrace[1].wOp
    /\ wPhase = _TETrace[1].wPhase
    /\ wEpoch = _TETrace[1].wEpoch
    /\ wCommitted = _TETrace[1].wCommitted
    /\ wRec = _TETrace[1].wRec
    /\ faults = _TETrace[1].faults
    /\ outOfSync = _TETrace[1].outOfSync
    /\ wRes = _TETrace[1].wRes
    /\ inflight = _TETrace[1].inflight
    /\ nextSerial = _TETrace[1].nextSerial
    /\ up = _TETrace[1].up
    /\ srvPend = _TETrace[1].srvPend
    /\ jn = _TETrace[1].jn
    /\ wSeg = _TETrace[1].wSeg
----

_next ==
    /\ \E i,j \in DOMAIN _TETrace:
        /\ \/ /\ j = i + 1
              /\ i = TLCGet("level")
        /\ chQ  = _TETrace[i].chQ
        /\ chQ' = _TETrace[j].chQ
        /\ wCid  = _TETrace[i].wCid
        /\ wCid' = _TETrace[j].wCid
        /\ targetFired  = _TETrace[i].targetFired
        /\ targetFired' = _TETrace[j].targetFired
        /\ wOp  = _TETrace[i].wOp
        /\ wOp' = _TETrace[j].wOp
        /\ wPhase  = _TETrace[i].wPhase
        /\ wPhase' = _TETrace[j].wPhase
        /\ wEpoch  = _TETrace[i].wEpoch
        /\ wEpoch' = _TETrace[j].wEpoch
        /\ wCommitted  = _TETrace[i].wCommitted
        /\ wCommitted' = _TETrace[j].wCommitted
        /\ wRec  = _TETrace[i].wRec
        /\ wRec' = _TETrace[j].wRec
        /\ faults  = _TETrace[i].faults
        /\ faults' = _TETrace[j].faults
        /\ outOfSync  = _TETrace[i].outOfSync
        /\ outOfSync' = _TETrace[j].outOfSync
        /\ wRes  = _TETrace[i].wRes
        /\ wRes' = _TETrace[j].wRes
        /\ inflight  = _TETrace[i].inflight
        /\ inflight' = _TETrace[j].inflight
        /\ nextSerial  = _TETrace[i].nextSerial
        /\ nextSerial' = _TETrace[j].nextSerial
        /\ up  = _TETrace[i].up
        /\ up' = _TETrace[j].up
        /\ srvPend  = _TETrace[i].srvPend
        /\ srvPend' = _TETrace[j].srvPend
        /\ jn  = _TETrace[i].jn
        /\ jn' = _TETrace[j].jn
        /\ wSeg  = _TETrace[i].wSeg
        /\ wSeg' = _TETrace[j].wSeg

\* Uncomment the ASSUME below to write the states of the error trace
\* to the given file in Json format. Note that you can pass any tuple
\* to `JsonSerialize`. For example, a sub-sequence of _TETrace.
    \* ASSUME
    \*     LET J == INSTANCE Json
    \*         IN J!JsonSerialize("MC_TTrace_1793567993.json", _TETrace)

=============================================================================

 Note that you can extract this module `MC_TEExpression`
  to a dedicated file to reuse `expression` (the module in the 
  dedicated `MC_TEExpression.tla` file takes precedence 
  over the module `MC_TEExpression` below).

---- MODULE MC_TEExpression ----
EXTENDS Sequences, TLCExt, MC, Toolbox, Naturals, TLC, MC_TEConstants

expression == 
    [
        \* To hide variables of the `MC` spec from the error trace,
        \* remove the variables below.  The trace will be written in the order
        \* of the fields of this record.
        chQ |-> chQ
        ,wCid |-> wCid
        ,targetFired |-> targetFired
        ,wOp |-> wOp
        ,wPhase |-> wPhase
        ,wEpoch |-> wEpoch
        ,wCommitted |-> wCommitted
        ,wRec |-> wRec
        ,faults |-> faults
        ,outOfSync |-> outOfSync
        ,wRes |-> wRes
        ,inflight |-> inflight
        ,nextSerial |-> nextSerial
        ,up |-> up
        ,srvPend |-> srvPend
        ,jn |-> jn
        ,wSeg |-> wSeg
        
        \* Put additional constant-, state-, and action-level expressions here:
        \* ,_stateNumber |-> _TEPosition
        \* ,_chQUnchanged |-> chQ = chQ'
        
        \* Format the `chQ` variable as Json value.
        \* ,_chQJson |->
        \*     LET J == INSTANCE Json
        \*     IN J!ToJson(chQ)
        
        \* Lastly, you may build expressions over arbitrary sets of states by
        \* leveraging the _TETrace operator.  For example, this is how to
        \* count the number of times a spec variable changed up to the current
        \* state in the trace.
        \* ,_chQModCount |->
        \*     LET F[s \in DOMAIN _TETrace] ==
        \*         IF s = 1 THEN 0
        \*         ELSE IF _TETrace[s].chQ # _TETrace[s-1].chQ
        \*             THEN 1 + F[s-1] ELSE F[s-1]
        \*     IN F[_TEPosition - 1]
    ]

=============================================================================



Parsing and semantic processing can take forever if the trace below is long.
 In this case, it is advised to uncomment the module below to deserialize the
 trace from a generated binary file.

\*
\*---- MODULE MC_TETrace ----
\*EXTENDS IOUtils, MC, TLC, MC_TEConstants
\*
\*trace == IODeserialize("MC_TTrace_1793567993.bin", TRUE)
\*
\*=============================================================================
\*

