        /\
        wr = (<<[pc |-> "send", opened |-> TRUE, last |-> 1, seg |-> 1, c |-> 1, S |-> 0, ep |-> 1, call |-> [s |-> 1, op |-> "jrnl", c |-> 0, src |-> NoJN, x |-> 0, f |-> 2, e |-> 2, ip |-> FALSE, rop |-> "jrnl", ep |-> 0, ov |-> FALSE], resp |-> (j0 :> [k |-> "ok", end |-> 0, c |-> 0, ip |-> FALSE, pe |-> 0, ls |-> 0, has |-> FALSE, ae |-> 0, lwe |-> 0] @@ j1 :> [k |-> "none", end |-> 0, c |-> 0, ip |-> FALSE, pe |-> 0, ls |-> 0, has |-> FALSE, ae |-> 0, lwe |-> 0] @@ j2 :> [k |-> "none", end |-> 0, c |-> 0, ip |-> FALSE, pe |-> 0, ls |-> 0, has |-> FALSE, ae |-> 0, lwe |-> 0]), dec |-> [end |-> 0, src |-> NoJN, ip |-> FALSE]], [pc |-> "act", opened |-> TRUE, last |-> 2, seg |-> 2, c |-> 2, S |-> 0, ep |-> 2, call |-> [s |-> 0, op |-> "none", c |-> 0, src |-> NoJN, x |-> 0, f |-> 0, e |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], resp |-> (j0 :> [k |-> "none", end |-> 0, c |-> 0, ip |-> FALSE, pe |-> 0, ls |-> 0, has |-> FALSE, ae |-> 0, lwe |-> 0] @@ j1 :> [k |-> "none", end |-> 0, c |-> 0, ip |-> FALSE, pe |-> 0, ls |-> 0, has |-> FALSE, ae |-> 0, lwe |-> 0] @@ j2 :> [k |-> "none", end |-> 0, c |-> 0, ip |-> FALSE, pe |-> 0, ls |-> 0, has |-> FALSE, ae |-> 0, lwe |-> 0]), dec |-> [end |-> 0, src |-> NoJN, ip |-> FALSE]]>>)
        /\
        fc = ([crash |-> 0, drop |-> 0, late |-> 0, lose |-> 0, reject |-> 0, acrash |-> 0, wcrash |-> 0, purge |-> 0])
    )
----

_init ==
    /\ targetFired = _TETrace[1].targetFired
    /\ otherFired = _TETrace[1].otherFired
    /\ ch = _TETrace[1].ch
    /\ fc = _TETrace[1].fc
    /\ jn = _TETrace[1].jn
    /\ wr = _TETrace[1].wr
----

_next ==
    /\ \E i,j \in DOMAIN _TETrace:
        /\ \/ /\ j = i + 1
              /\ i = TLCGet("level")
        /\ targetFired  = _TETrace[i].targetFired
        /\ targetFired' = _TETrace[j].targetFired
        /\ otherFired  = _TETrace[i].otherFired
        /\ otherFired' = _TETrace[j].otherFired
        /\ ch  = _TETrace[i].ch
        /\ ch' = _TETrace[j].ch
        /\ fc  = _TETrace[i].fc
        /\ fc' = _TETrace[j].fc
        /\ jn  = _TETrace[i].jn
        /\ jn' = _TETrace[j].jn
        /\ wr  = _TETrace[i].wr
        /\ wr' = _TETrace[j].wr

\* Uncomment the ASSUME below to write the states of the error trace
\* to the given file in Json format. Note that you can pass any tuple
\* to `JsonSerialize`. For example, a sub-sequence of _TETrace.
    \* ASSUME
    \*     LET J == INSTANCE Json
    \*         IN J!JsonSerialize("MC_TTrace_1793567814.json", _TETrace)

=============================================================================

 Note that you can extract this module `MC_TEExpression`
  to a dedicated file to reuse `expression` (the module in the 
  dedicated `MC_TEExpression.tla` file takes precedence 
  over the module `MC_TEExpression` below).

---- MODULE MC_TEExpression ----
EXTENDS Sequences, TLCExt, MC, Toolbox, Naturals, TLC, MC_TEConstants

expression == 
    [
        \* To hide variables of the `MC` spec from the error trace,
        \* remove the variables below.  The trace will be written in the order
        \* of the fields of this record.
        targetFired |-> targetFired
        ,otherFired |-> otherFired
        ,ch |-> ch
        ,fc |-> fc
        ,jn |-> jn
        ,wr |-> wr
        
        \* Put additional constant-, state-, and action-level expressions here:
        \* ,_stateNumber |-> _TEPosition
        \* ,_targetFiredUnchanged |-> targetFired = targetFired'
        
        \* Format the `targetFired` variable as Json value.
        \* ,_targetFiredJson |->
        \*     LET J == INSTANCE Json
        \*     IN J!ToJson(targetFired)
        
        \* Lastly, you may build expressions over arbitrary sets of states by
        \* leveraging the _TETrace operator.  For example, this is how to
        \* count the number of times a spec variable changed up to the current
        \* state in the trace.
        \* ,_targetFiredModCount |->
        \*     LET F[s \in DOMAIN _TETrace] ==
        \*         IF s = 1 THEN 0
        \*         ELSE IF _TETrace[s].targetFired # _TETrace[s-1].targetFired
        \*             THEN 1 + F[s-1] ELSE F[s-1]
        \*     IN F[_TEPosition - 1]
    ]

=============================================================================



Parsing and semantic processing can take forever if the trace below is long.
 In this case, it is advised to uncomment the module below to deserialize the
 trace from a generated binary file.

\*
\*---- MODULE MC_TETrace ----
\*EXTENDS IOUtils, MC, TLC, MC_TEConstants
\*
\*trace == IODeserialize("MC_TTrace_1793567814.bin", TRUE)
\*
\*=============================================================================
\*

---- MODULE MC_TETrace ----
EXTENDS MC, TLC, MC_TEConstants

