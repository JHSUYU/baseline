rop |-> "start", ep |-> 0, ov |-> FALSE], [s |-> 2, op |-> "jrnl", c |-> 0, src |-> NoJN, x |-> 0, f |-> 2, e |-> 2, ip |-> FALSE, rop |-> "jrnl", ep |-> 0, ov |-> FALSE]>>, inf |-> [s |-> 0, op |-> "none", c |-> 0, src |-> NoJN, x |-> 0, f |-> 0, e |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], zb |-> [s |-> 0, op |-> "none", c |-> 0, src |-> NoJN, x |-> 0, f |-> 0, e |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], oos |-> FALSE, hb |-> FALSE] @@ j1 :> [q |-> <<>>, inf |-> [s |-> 0, op |-> "none", c |-> 0, src |-> NoJN, x |-> 0, f |-> 0, e |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], zb |-> [s |-> 0, op |-> "none", c |-> 0, src |-> NoJN, x |-> 0, f |-> 0, e |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], oos |-> FALSE, hb |-> FALSE] @@ j2 :> [q |-> <<>>, inf |-> [s |-> 0, op |-> "none", c |-> 0, src |-> NoJN, x |-> 0, f |-> 0, e |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], zb |-> [s |-> 0, op |-> "none", c |-> 0, src |-> NoJN, x |-> 0, f |-> 0, e |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], oos |-> FALSE, hb |-> FALSE])>>)
        /\
