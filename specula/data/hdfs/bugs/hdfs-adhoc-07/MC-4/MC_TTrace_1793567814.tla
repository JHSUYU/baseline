---- MODULE MC_TTrace_1793567814 ----
EXTENDS Sequences, TLCExt, MC, Toolbox, Naturals, TLC, MC_TEConstants

_expression ==
    LET MC_TEExpression == INSTANCE MC_TEExpression
    IN MC_TEExpression!expression
----

_trace ==
    LET MC_TETrace == INSTANCE MC_TETrace
    IN MC_TETrace!trace
----

_inv ==
    ~(
        TLCGet("level") = Len(_TETrace)
        /\
        otherFired = ({})
        /\
        jn = ((j0 :> [fc |-> 1, files |-> <<[ex |-> TRUE, end |-> 2, ip |-> TRUE], [ex |-> FALSE, end |-> 0, ip |-> FALSE]>>, up |-> TRUE, c |-> 2, lwe |-> 1, pr |-> 2, paxos |-> <<[ex |-> FALSE, end |-> 0, ip |-> FALSE, ep |-> 0], [ex |-> FALSE, end |-> 0, ip |-> FALSE, ep |-> 0]>>, tmp |-> {}, cs |-> 0, nx |-> 0] @@ j1 :> [fc |-> 2, files |-> <<[ex |-> TRUE, end |-> 1, ip |-> FALSE], [ex |-> TRUE, end |-> 2, ip |-> TRUE]>>, up |-> TRUE, c |-> 0, lwe |-> 2, pr |-> 2, paxos |-> <<[ex |-> FALSE, end |-> 0, ip |-> FALSE, ep |-> 0], [ex |-> FALSE, end |-> 0, ip |-> FALSE, ep |-> 0]>>, tmp |-> {}, cs |-> 2, nx |-> 3] @@ j2 :> [fc |-> 2, files |-> <<[ex |-> TRUE, end |-> 1, ip |-> FALSE], [ex |-> TRUE, end |-> 2, ip |-> TRUE]>>, up |-> TRUE, c |-> 0, lwe |-> 2, pr |-> 2, paxos |-> <<[ex |-> FALSE, end |-> 0, ip |-> FALSE, ep |-> 0], [ex |-> FALSE, end |-> 0, ip |-> FALSE, ep |-> 0]>>, tmp |-> {}, cs |-> 2, nx |-> 3]))
        /\
