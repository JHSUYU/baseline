        /\
        targetFired = (TRUE)
        /\
        wr = (<<[pc |-> "act", c |-> 2, opened |-> TRUE, last |-> 2, seg |-> 1, S |-> 0, ep |-> 1, call |-> [c |-> 0, s |-> 0, op |-> "none", src |-> NoJN, e |-> 0, x |-> 0, f |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], resp |-> (j0 :> [c |-> 0, k |-> "none", end |-> 0, ip |-> FALSE, pe |-> 0, ls |-> 0, has |-> FALSE, ae |-> 0, lwe |-> 0] @@ j1 :> [c |-> 0, k |-> "none", end |-> 0, ip |-> FALSE, pe |-> 0, ls |-> 0, has |-> FALSE, ae |-> 0, lwe |-> 0] @@ j2 :> [c |-> 0, k |-> "none", end |-> 0, ip |-> FALSE, pe |-> 0, ls |-> 0, has |-> FALSE, ae |-> 0, lwe |-> 0]), dec |-> [end |-> 0, src |-> NoJN, ip |-> FALSE]], [pc |-> "acc", c |-> 0, opened |-> FALSE, last |-> 0, seg |-> 0, S |-> 1, ep |-> 2, call |-> [c |-> 0, s |-> 1, op |-> "acc", src |-> j2, e |-> 1, x |-> 0, f |-> 0, ip |-> TRUE, rop |-> "acc", ep |-> 0, ov |-> FALSE], resp |-> (j0 :> [c |-> 0, k |-> "none", end |-> 0, ip |-> FALSE, pe |-> 0, ls |-> 0, has |-> FALSE, ae |-> 0, lwe |-> 0] @@ j1 :> [c |-> 0, k |-> "aerr", end |-> 0, ip |-> FALSE, pe |-> 0, ls |-> 0, has |-> FALSE, ae |-> 0, lwe |-> 0] @@ j2 :> [c |-> 0, k |-> "none", end |-> 0, ip |-> FALSE, pe |-> 0, ls |-> 0, has |-> FALSE, ae |-> 0, lwe |-> 0]), dec |-> [end |-> 1, src |-> j2, ip |-> TRUE]]>>)
        /\
        fc = ([purge |-> 1, crash |-> 1, drop |-> 0, late |-> 0, lose |-> 0, reject |-> 0, acrash |-> 0, wcrash |-> 0])
    )
----

_init ==
    /\ targetFired = _TETrace[1].targetFired
    /\ otherFired = _TETrace[1].otherFired
    /\ ch = _TETrace[1].ch
    /\ fc = _TETrace[1].fc
    /\ jn = _TETrace[1].jn
    /\ wr = _TETrace[1].wr
----

_next ==
    /\ \E i,j \in DOMAIN _TETrace:
        /\ \/ /\ j = i + 1
              /\ i = TLCGet("level")
        /\ targetFired  = _TETrace[i].targetFired
        /\ targetFired' = _TETrace[j].targetFired
        /\ otherFired  = _TETrace[i].otherFired
        /\ otherFired' = _TETrace[j].otherFired
        /\ ch  = _TETrace[i].ch
        /\ ch' = _TETrace[j].ch
        /\ fc  = _TETrace[i].fc
        /\ fc' = _TETrace[j].fc
        /\ jn  = _TETrace[i].jn
        /\ jn' = _TETrace[j].jn
        /\ wr  = _TETrace[i].wr
        /\ wr' = _TETrace[j].wr

\* Uncomment the ASSUME below to write the states of the error trace
\* to the given file in Json format. Note that you can pass any tuple
\* to `JsonSerialize`. For example, a sub-sequence of _TETrace.
    \* ASSUME
    \*     LET J == INSTANCE Json
    \*         IN J!JsonSerialize("MCGuided1_TTrace_1793567345.json", _TETrace)

=============================================================================

 Note that you can extract this module `MCGuided1_TEExpression`
  to a dedicated file to reuse `expression` (the module in the 
  dedicated `MCGuided1_TEExpression.tla` file takes precedence 
  over the module `MCGuided1_TEExpression` below).

---- MODULE MCGuided1_TEExpression ----
EXTENDS MCGuided1_TEConstants, Sequences, TLCExt, Toolbox, Naturals, TLC, MCGuided1

expression == 
    [
        \* To hide variables of the `MCGuided1` spec from the error trace,
        \* remove the variables below.  The trace will be written in the order
        \* of the fields of this record.
        targetFired |-> targetFired
        ,otherFired |-> otherFired
        ,ch |-> ch
        ,fc |-> fc
        ,jn |-> jn
        ,wr |-> wr
        
        \* Put additional constant-, state-, and action-level expressions here:
        \* ,_stateNumber |-> _TEPosition
        \* ,_targetFiredUnchanged |-> targetFired = targetFired'
        
        \* Format the `targetFired` variable as Json value.
        \* ,_targetFiredJson |->
        \*     LET J == INSTANCE Json
        \*     IN J!ToJson(targetFired)
        
        \* Lastly, you may build expressions over arbitrary sets of states by
        \* leveraging the _TETrace operator.  For example, this is how to
        \* count the number of times a spec variable changed up to the current
        \* state in the trace.
        \* ,_targetFiredModCount |->
        \*     LET F[s \in DOMAIN _TETrace] ==
        \*         IF s = 1 THEN 0
        \*         ELSE IF _TETrace[s].targetFired # _TETrace[s-1].targetFired
        \*             THEN 1 + F[s-1] ELSE F[s-1]
        \*     IN F[_TEPosition - 1]
    ]

=============================================================================



Parsing and semantic processing can take forever if the trace below is long.
 In this case, it is advised to uncomment the module below to deserialize the
 trace from a generated binary file.

\*
\*---- MODULE MCGuided1_TETrace ----
\*EXTENDS MCGuided1_TEConstants, IOUtils, TLC, MCGuided1
\*
\*trace == IODeserialize("MCGuided1_TTrace_1793567345.bin", TRUE)
\*
\*=============================================================================
\*

