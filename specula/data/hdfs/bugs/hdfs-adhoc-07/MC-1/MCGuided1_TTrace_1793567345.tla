---- MODULE MCGuided1_TTrace_1793567345 ----
EXTENDS MCGuided1_TEConstants, Sequences, TLCExt, Toolbox, Naturals, TLC, MCGuided1

_expression ==
    LET MCGuided1_TEExpression == INSTANCE MCGuided1_TEExpression
    IN MCGuided1_TEExpression!expression
----

_trace ==
    LET MCGuided1_TETrace == INSTANCE MCGuided1_TETrace
    IN MCGuided1_TETrace!trace
----

_inv ==
    ~(
        TLCGet("level") = Len(_TETrace)
        /\
        otherFired = ({})
        /\
        jn = ((j0 :> [fc |-> 0, c |-> 1, up |-> TRUE, files |-> <<[ex |-> FALSE, end |-> 0, ip |-> FALSE], [ex |-> FALSE, end |-> 0, ip |-> FALSE]>>, lwe |-> 1, pr |-> 2, paxos |-> <<[ex |-> FALSE, end |-> 0, ip |-> FALSE, ep |-> 0], [ex |-> FALSE, end |-> 0, ip |-> FALSE, ep |-> 0]>>, tmp |-> {}, cs |-> 0, nx |-> 0] @@ j1 :> [fc |-> 1, c |-> 2, up |-> TRUE, files |-> <<[ex |-> TRUE, end |-> 2, ip |-> TRUE], [ex |-> FALSE, end |-> 0, ip |-> FALSE]>>, lwe |-> 1, pr |-> 2, paxos |-> <<[ex |-> FALSE, end |-> 0, ip |-> FALSE, ep |-> 0], [ex |-> FALSE, end |-> 0, ip |-> FALSE, ep |-> 0]>>, tmp |-> {}, cs |-> 0, nx |-> 0] @@ j2 :> [fc |-> 1, c |-> 1, up |-> TRUE, files |-> <<[ex |-> TRUE, end |-> 1, ip |-> TRUE], [ex |-> FALSE, end |-> 0, ip |-> FALSE]>>, lwe |-> 1, pr |-> 2, paxos |-> <<[ex |-> FALSE, end |-> 0, ip |-> FALSE, ep |-> 0], [ex |-> FALSE, end |-> 0, ip |-> FALSE, ep |-> 0]>>, tmp |-> {}, cs |-> 0, nx |-> 0]))
        /\
        ch = (<<(j0 :> [inf |-> [c |-> 0, s |-> 0, op |-> "none", src |-> NoJN, e |-> 0, x |-> 0, f |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], q |-> <<>>, zb |-> [c |-> 0, s |-> 0, op |-> "none", src |-> NoJN, e |-> 0, x |-> 0, f |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], oos |-> FALSE, hb |-> FALSE] @@ j1 :> [inf |-> [c |-> 0, s |-> 0, op |-> "none", src |-> NoJN, e |-> 0, x |-> 0, f |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], q |-> <<>>, zb |-> [c |-> 0, s |-> 0, op |-> "none", src |-> NoJN, e |-> 0, x |-> 0, f |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], oos |-> FALSE, hb |-> FALSE] @@ j2 :> [inf |-> [c |-> 0, s |-> 0, op |-> "none", src |-> NoJN, e |-> 0, x |-> 0, f |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], q |-> <<[c |-> 0, s |-> 1, op |-> "jrnl", src |-> NoJN, e |-> 2, x |-> 0, f |-> 2, ip |-> FALSE, rop |-> "jrnl", ep |-> 0, ov |-> FALSE], [c |-> 0, s |-> 1, op |-> "purge", src |-> NoJN, e |-> 0, x |-> 0, f |-> 0, ip |-> FALSE, rop |-> "purge", ep |-> 0, ov |-> FALSE]>>, zb |-> [c |-> 0, s |-> 0, op |-> "none", src |-> NoJN, e |-> 0, x |-> 0, f |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], oos |-> FALSE, hb |-> FALSE]), (j0 :> [inf |-> [c |-> 0, s |-> 0, op |-> "none", src |-> NoJN, e |-> 0, x |-> 0, f |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], q |-> <<[c |-> 0, s |-> 1, op |-> "acc", src |-> j2, e |-> 1, x |-> 0, f |-> 0, ip |-> TRUE, rop |-> "acc", ep |-> 0, ov |-> FALSE]>>, zb |-> [c |-> 0, s |-> 0, op |-> "none", src |-> NoJN, e |-> 0, x |-> 0, f |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], oos |-> FALSE, hb |-> FALSE] @@ j1 :> [inf |-> [c |-> 0, s |-> 0, op |-> "none", src |-> NoJN, e |-> 0, x |-> 0, f |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], q |-> <<>>, zb |-> [c |-> 0, s |-> 0, op |-> "none", src |-> NoJN, e |-> 0, x |-> 0, f |-> 0, ip |-> FALSE, rop |-> "none", ep |-> 0, ov |-> FALSE], oo