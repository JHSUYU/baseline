---- MODULE MC_TTrace_1794187162 ----
EXTENDS Sequences, TLCExt, MC, Toolbox, Naturals, TLC

_expression ==
    LET MC_TEExpression == INSTANCE MC_TEExpression
    IN MC_TEExpression!expression
----

_trace ==
    LET MC_TETrace == INSTANCE MC_TETrace
    IN MC_TETrace!trace
----

_inv ==
    ~(
        TLCGet("level") = Len(_TETrace)
        /\
        cs = ([replicas |-> {[coll |-> "coll1", shard |-> "shard1", core |-> "c1s1", cnn |-> 1, nn |-> TRUE], [coll |-> "coll1", shard |-> "shard2", core |-> "c1s2", cnn |-> 2, nn |-> TRUE], [coll |-> "target", shard |-> "shard1", core |-> "tgtR1", cnn |-> 1, nn |-> TRUE], [coll |-> "temp", shard |-> "shard1", core |-> "tmpR1", cnn |-> 1, nn |-> TRUE]}, slices |-> {<<"coll1", "shard1">>, <<"coll1", "shard2">>, <<"target", "shard1">>, <<"temp", "shard1">>}, colls |-> {"coll1", "target", "temp"}, rule |-> TRUE])
        /\
        nodeCores = ({"tgtR1", "tmpR1"})
        /\
        targetFired = (TRUE)
        /\
        ocpView = ([replicas |-> {[coll |-> "coll1", shard |-> "shard1", core |-> "c1s1", cnn |-> 1, nn |-> TRUE], [coll |-> "coll1", shard |-> "shard2", core |-> "c1s2", cnn |-> 2, nn |-> TRUE], [coll |-> "target", shard |-> "shard1", core |-> "tgtR1", cnn |-> 1, nn |-> TRUE], [coll |-> "temp", shard |-> "shard1", core |-> "tmpR1", cnn |-> 1, nn |-> TRUE]}, slices |-> {<<"coll1", "shard1">>, <<"coll1", "shard2">>, <<"target", "shard1">>, <<"temp", "shard1">>}, colls |-> {"coll1", "target", "temp"}, rule |-> TRUE])
        /\
        clusterProps = ("false")
        /\
        opIdx = (2)
        /\
        cupLegacy = (FALSE)
        /\
        firedCore = ("tmpR2")
        /\
        faults = ([propFlips |-> 0, checkTimeouts |-> 0])
        /\
        stateQ = (<<>>)
        /\
        ocp = ([coll |-> "temp", cnn |-> 0, pc |-> "mk_collect2", result |-> "ok", snap |-> FALSE, ret |-> "mk_waitCNN1"])
        /\
        req = ([tgtR1 |-> [cnn |-> 1, st |-> "ok", hasCNN |-> TRUE], tmpR1 |-> [cnn |-> 1, st |-> "ok", hasCNN |-> TRUE], tmpR2 |-> [cnn |-> 0, st |-> "err", hasCNN |-> FALSE], implR1 |-> [cnn |-> 0, st |-> "none", hasCNN |-> FALSE], addR |-> [cnn |-> 0, st |-> "none", hasCNN |-> FALSE]])
    )
----

_init ==
    /\ clusterProps = _TETrace[1].clusterProps
    /\ targetFired = _TETrace[1].targetFired
    /\ cs = _TETrace[1].cs
    /\ cupLegacy = _TETrace[1].cupLegacy
    /\ firedCore = _TETrace[1].firedCore
    /\ nodeCores = _TETrace[1].nodeCores
    /\ faults = _TETrace[1].faults
    /\ stateQ = _TETrace[1].stateQ
    /\ req = _TETrace[1].req
    /\ opIdx = _TETrace[1].opIdx
    /\ ocp = _TETrace[1].ocp
    /\ ocpView = _TETrace[1].ocpView
----

_next ==
    /\ \E i,j \in DOMAIN _TETrace:
        /\ \/ /\ j = i + 1
              /\ i = TLCGet("level")
        /\ clusterProps  = _TETrace[i].clusterProps
        /\ clusterProps' = _TETrace[j].clusterProps
        /\ targetFired  = _TETrace[i].targetFired
        /\ targetFired' = _TETrace[j].targetFired
        /\ cs  = _TETrace[i].cs
        /\ cs' = _TETrace[j].cs
        /\ cupLegacy  = _TETrace[i].cupLegacy
        /\ cupLegacy' = _TETrace[j].cupLegacy
        /\ firedCore  = _TETrace[i].firedCore
        /\ firedCore' = _TETrace[j].firedCore
        /\ nodeCores  = _TETrace[i].nodeCores
        /\ nodeCores' = _TETrace[j].nodeCores
        /\ faults  = _TETrace[i].faults
        /\ faults' = _TETrace[j].faults
        /\ stateQ  = _TETrace[i].stateQ
        /\ stateQ' = _TETrace[j].stateQ
        /\ req  = _TETrace[i].req
        /\ req' = _TETrace[j].req
        /\ opIdx  = _TETrace[i].opIdx
        /\ opIdx' = _TETrace[j].opIdx
        /\ ocp  = _TETrace[i].ocp
        /\ ocp' = _TETrace[j].ocp
        /\ ocpView  = _TETrace[i].ocpView
        /\ ocpView' = _TETrace[j].ocpView

\* Uncomment the ASSUME below to write the states of the error trace
\* to the given file in Json format. Note that you can pass any tuple
\* to `JsonSerialize`. For example, a sub-sequence of _TETrace.
    \* ASSUME
    \*     LET J == INSTANCE Json
    \*         IN J!JsonSerialize("MC_TTrace_1794187162.json", _TETrace)

=============================================================================

 Note that you can extract this module `MC_TEExpression`
  to a dedicated file to reuse `expression` (the module in the 
  dedicated `MC_TEExpression.tla` file takes precedence 
  over the module `MC_TEExpression` below).

---- MODULE MC_TEExpression ----
EXTENDS Sequences, TLCExt, MC, Toolbox, Naturals, TLC

expression == 
    [
        \* To hide variables of the `MC` spec from the error trace,
        \* remove the variables below.  The trace will be written in the order
        \* of the fields of this record.
        clusterProps |-> clusterProps
        ,targetFired |-> targetFired
        ,cs |-> cs
        ,cupLegacy |-> cupLegacy
        ,firedCore |-> firedCore
        ,nodeCores |-> nodeCores
        ,faults |-> faults
        ,stateQ |-> stateQ
        ,req |-> req
        ,opIdx |-> opIdx
        ,ocp |-> ocp
        ,ocpView |-> ocpView
        
        \* Put additional constant-, state-, and action-level expressions here:
        \* ,_stateNumber |-> _TEPosition
        \* ,_clusterPropsUnchanged |-> clusterProps = clusterProps'
        
        \* Format the `clusterProps` variable as Json value.
        \* ,_clusterPropsJson |->
        \*     LET J == INSTANCE Json
        \*     IN J!ToJson(clusterProps)
        
        \* Lastly, you may build expressions over arbitrary sets of states by
        \* leveraging the _TETrace operator.  For example, this is how to
        \* count the number of times a spec variable changed up to the current
        \* state in the trace.
        \* ,_clusterPropsModCount |->
        \*     LET F[s \in DOMAIN _TETrace] ==
        \*         IF s = 1 THEN 0
        \*         ELSE IF _TETrace[s].clusterProps # _TETrace[s-1].clusterProps
        \*             THEN 1 + F[s-1] ELSE F[s-1]
        \*     IN F[_TEPosition - 1]
    ]

=============================================================================



Parsing and semantic processing can take forever if the trace below is long.
 In this case, it is advised to uncomment the module below to deserialize the
 trace from a generated binary file.

\*
\*---- MODULE MC_TETrace ----
\*EXTENDS IOUtils, MC, TLC
\*
\*trace == IODeserialize("MC_TTrace_1794187162.bin", TRUE)
\*
\*=============================================================================
\*

