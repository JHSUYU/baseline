   [junit4]   1>            <dynamicField name="*_str" type="strings" stored="false" docValues="true" indexed="false" />
   [junit4]   1>        
   [junit4]   1>            <dynamicField name="*_dt"  type="pdate"    indexed="true"  stored="true"/>
