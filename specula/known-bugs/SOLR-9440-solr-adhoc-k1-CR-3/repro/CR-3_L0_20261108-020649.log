   [junit4]   1>            <dynamicField name="*_dpf" type="delimited_payloads_float" indexed="true"  stored="true"/>
   [junit4]   1>            <dynamicField name="*_dpi" type="delimited_payloads_int" indexed="true"  stored="true"/>
