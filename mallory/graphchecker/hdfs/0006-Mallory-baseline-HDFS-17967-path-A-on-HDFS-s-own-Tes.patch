From 3d98925abf6a1b8e0112f2256a6859845295d4eb Mon Sep 17 00:00:00 2001
From: ZhenyuLi
 <ZhenyuLi@node0.experiment.silentfailure-pg0.clemson.cloudlab.us>
Date: Mon, 26 Oct 2026 02:39:42 +0000
Subject: [PATCH 6/6] Mallory baseline: HDFS-17967 path A on HDFS's own
 TestEncryptedTransfer

hdfs-17967-pathA-upstream runs testLongLivedClientPipelineRecovery
unchanged, with the cluster adapter's automatic identities, against the
target hdfs-17967-pathA marks (marked_as).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 experiments/hadoop/hdfs-17967/case.sh | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/experiments/hadoop/hdfs-17967/case.sh b/experiments/hadoop/hdfs-17967/case.sh
index 9e5715f2a..8b83dd652 100644
--- a/experiments/hadoop/hdfs-17967/case.sh
+++ b/experiments/hadoop/hdfs-17967/case.sh
@@ -6,6 +6,18 @@ case "${1:?usage: case.sh pathA|pathB|pathC}" in
     target_occurrence="hdfs-17967/mirror-dn#epoch0/region/REGION.7c569c3f-b4d3-305a-bd9c-bebff1048122#1"
     scope=("${blockkey_scope[@]}" client:org/apache/hadoop/hdfs/DFSClient)
     ;;
+  pathA-upstream)
+    # The Mallory baseline's workload for path A: HDFS's own TestEncryptedTransfer, unchanged.
+    # It rotates block keys every 2 s itself, then appends through a recovered write pipeline,
+    # whose head opens its own connection to the next DataNode (DataXceiver.writeBlock).
+    repo=${GC_TREES}/hadoop-hdfs-study-r7
+    test_class=org.apache.hadoop.hdfs.TestEncryptedTransfer
+    test_method='testLongLivedClientPipelineRecovery[1]'
+    marked_as=hdfs-17967-pathA
+    target_occurrence=first
+    cluster_automatic=true
+    scope=("${blockkey_scope[@]}" client:org/apache/hadoop/hdfs/DFSClient)
+    ;;
   pathB)
     repo=${GC_TREES}/hadoop-hdfs-study-r7
     test_class=org.apache.hadoop.hdfs.server.datanode.TestCausynthReplaceBlockProxyStaleKey
