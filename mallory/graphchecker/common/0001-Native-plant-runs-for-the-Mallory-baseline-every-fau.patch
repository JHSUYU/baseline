+# plant-run <run dir> <plant> [<bound s>]: one native run of the case's workload
+# on the recording weave of its SEED (CAUSYNTH_OUTPUT_DIR's instrumented
+# classes), planting <plant> as REPRODUCE does: the run dir gets the run's
+# runtime_trace.jsonl (with its PLANT_* rows; PLANT_MARKER for every fault
+# marker evaluated when -Dcausynth.plant.observe=true is among
+# CAUSYNTH_WORKLOAD_JAVA_OPTS), schedule.jsonl and logs.  The Mallory
+# baseline drives its fault trials through this.
+do_plant_run() {
+  local run=${1:?plant-run needs a run directory} plant=${2:?plant-run needs a plant}
+  local bound=${3:-} status=0
+  require_directory "the SEED's recording weave" "${analysis_classes_dir}"
+  require_file "a plant" "${plant}"
+  mkdir -p "${run}"
+  hostname -s >"${run}/host.txt"
+  run_configured_workload "${run}" "${bound}" "${plant}" "" "" \
+    >"${run}/stdout.log" 2>"${run}/stderr.log" || status=$?
+  printf '%s\n' "${status}" >"${run}/exit"
+  return "${status}"
+}
