+++ b/src/main/java/edu/uva/liftlab/graphchecker/explore/TargetRows.java
@@ -0,0 +1,52 @@
+package edu.uva.liftlab.graphchecker.explore;
+
+import com.google.gson.JsonObject;
+import edu.uva.liftlab.graphchecker.contract.OccurrenceAddress;
+import edu.uva.liftlab.graphchecker.plan.StaticScopeMap;
+import edu.uva.liftlab.graphchecker.runtime.RecordingPlant;
+
+import java.io.IOException;
+import java.nio.file.Paths;
+
+/**
+ * The TARGET rows of a native plant for a case's declared target occurrence,
+ * as {@link ConfirmMain} writes them for a witness: every TARGET_SITE guard of
+ * the static scope map with a stated fatal outcome, anchored at the declared
+ * occurrence's id. A planted run then states PLANT_FATAL (atAnchor) when the
+ * target takes its fatal arm there. Usage: TargetRows &lt;static scope map&gt;
+ * &lt;declared target occurrence address&gt;; one JSON row per line on stdout.
+ */
+public final class TargetRows {
+    private TargetRows() {
+    }
+
+    public static void main(String[] args) throws IOException {
+        if (args.length != 2) {
+            System.err.println("usage: TargetRows <static scope map> "
+                    + "<declared target occurrence>");
+            System.exit(2);
+        }
+        String anchor = OccurrenceAddress.parse(args[1]).id();
+        int rows = 0;
+        for (StaticScopeMap.Site target
+                : StaticScopeMap.read(Paths.get(args[0])).targetSites()) {
+            for (int index = 0; index < target.guards.size()
+                    && index < target.guardOutcomes.size(); index++) {
+                if (target.guardOutcomes.get(index) == null) continue;
+                JsonObject row = new JsonObject();
+                row.addProperty(RecordingPlant.KIND, RecordingPlant.TARGET);
+                row.addProperty(RecordingPlant.OCCURRENCE, anchor);
+                row.addProperty(RecordingPlant.SITE, target.guards.get(index));
+                row.addProperty(RecordingPlant.VALUE,
+                        target.guardOutcomes.get(index));
+                System.out.println(row);
+                rows++;
+            }
+        }
+        if (rows == 0) {
+            System.err.println(args[0] + " states no fatal arm of a "
+                    + "TARGET_SITE guard");
+            System.exit(1);
+        }
+    }
+}
