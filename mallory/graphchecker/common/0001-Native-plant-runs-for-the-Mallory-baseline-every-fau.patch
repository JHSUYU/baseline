+  campaign|config|validate|reproduce|plant-run|--run-obligation|--run-placed)
     [[ -n "${config_file}" ]] || die "${command_name} requires --config FILE"
     initialize_config "${config_file}"
     case "${command_name}" in
@@ -7761,6 +7788,7 @@ case "${command_name}" in
