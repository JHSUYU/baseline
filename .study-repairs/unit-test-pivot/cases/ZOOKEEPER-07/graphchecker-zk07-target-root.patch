diff --git a/src/test/java/edu/uva/liftlab/graphchecker/runtime/FailureTargetRegionPreservationTest.java b/src/test/java/edu/uva/liftlab/graphchecker/runtime/FailureTargetRegionPreservationTest.java
new file mode 100644
index 000000000..15d2b7f27
--- /dev/null
+++ b/src/test/java/edu/uva/liftlab/graphchecker/runtime/FailureTargetRegionPreservationTest.java
@@ -0,0 +1,96 @@
+package edu.uva.liftlab.graphchecker.runtime;
+
+import edu.uva.liftlab.graphchecker.contract.OccurrenceAddress;
+import edu.uva.liftlab.graphchecker.contract.Role;
+import org.junit.After;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.zip.GZIPOutputStream;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertTrue;
+
+/** The same static target root opens distinct nested occurrences in both modes. */
+public class FailureTargetRegionPreservationTest {
+    private static final String NODE = "zk-peer-1#epoch1";
+    private static final String PARENT = "REGION.peer-run";
+    private static final String TARGET = "REGION.register-with-leader";
+
+    @Rule
+    public final TemporaryFolder folder = new TemporaryFolder();
+
+    @After
+    public void reset() {
+        System.clearProperty("causynth.region.preserve.failure-target");
+        System.clearProperty("causynth.region.skeletons");
+        Identity.resetForTests();
+        Lineage.resetForTests();
+    }
+
+    @Test
+    public void staticFailureTargetOpensUniqueChildrenWhileOtherRegionsFold()
+            throws Exception {
+        java.io.File skeletons = folder.newFile("regions.jsonl.gz");
+        try (OutputStream out = new GZIPOutputStream(
+                Files.newOutputStream(skeletons.toPath()))) {
+            String rows = "{\"kind\":\"REGION_SKELETON\","
+                    + "\"regionId\":\"" + PARENT + "\","
+                    + "\"rootAuthority\":\"THREAD_ENTRY\"}\n"
+                    + "{\"kind\":\"REGION_SKELETON\","
+                    + "\"regionId\":\"" + TARGET + "\","
+                    + "\"rootAuthority\":\"FAILURE_TARGET_ENTRY\"}\n";
+            out.write(rows.getBytes(StandardCharsets.UTF_8));
+        }
+        System.setProperty("causynth.region.skeletons",
+                skeletons.getAbsolutePath());
+        System.setProperty("causynth.region.preserve.failure-target", "true");
+        Identity.resetForTests();
+        Lineage.resetForTests();
+
+        long parentRoot = Lineage.pushRoot(NODE, Role.of("PEER_RUN"), "");
+        OccurrenceAddress parent = Identity.occurrence(NODE, PARENT, true);
+        assertFalse(Identity.openedNone());
+        for (int attempt = 0; attempt < 2; attempt++) {
+            long childRoot = Lineage.pushRoot(NODE,
+                    Role.of("REGISTER_WITH_LEADER"), "");
+            OccurrenceAddress target = Identity.occurrence(NODE, TARGET,
+                    true);
+            assertFalse(Identity.openedNone());
+            assertEquals(TARGET, target.regionId());
+            assertEquals(target, Identity.currentOccurrence(NODE));
+            if (attempt == 0) {
+                firstTarget = target;
+            } else {
+                assertNotEquals(firstTarget, target);
+            }
+            Identity.regionExit();
+            assertEquals(parent, Identity.currentOccurrence(NODE));
+            Lineage.pop(childRoot);
+        }
+        Identity.regionExit();
+        Lineage.pop(parentRoot);
+    }
+
+    private OccurrenceAddress firstTarget;
+
+    @Test
+    public void defaultStillFoldsNestedFailureTarget() {
+        Identity.resetForTests();
+        Lineage.resetForTests();
+        long root = Lineage.pushRoot(NODE, Role.of("PEER_RUN"), "");
+        OccurrenceAddress parent = Identity.occurrence(NODE, PARENT, true);
+        OccurrenceAddress nested = Identity.occurrence(NODE, TARGET, true);
+        assertTrue(Identity.openedNone());
+        assertEquals(parent, nested);
+        Identity.regionExit();
+        Identity.regionExit();
+        Lineage.pop(root);
+    }
+}
