diff --git a/src/main/java/edu/uva/liftlab/graphchecker/runtime/FailureTargetRegionPreservation.java b/src/main/java/edu/uva/liftlab/graphchecker/runtime/FailureTargetRegionPreservation.java
new file mode 100644
index 000000000..881d383fb
--- /dev/null
+++ b/src/main/java/edu/uva/liftlab/graphchecker/runtime/FailureTargetRegionPreservation.java
@@ -0,0 +1,97 @@
+package edu.uva.liftlab.graphchecker.runtime;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.zip.GZIPInputStream;
+
+/**
+ * Opt-in nested occurrence roots derived from the static region skeletons.
+ * Recording and replay use this same predicate at their region entry hook.
+ */
+final class FailureTargetRegionPreservation {
+    private static final String ENABLED =
+            "causynth.region.preserve.failure-target";
+    private static final String SKELETONS = "causynth.region.skeletons";
+    private static volatile Set<String> preserved;
+
+    private FailureTargetRegionPreservation() {
+    }
+
+    static boolean preserves(String regionId) {
+        if (!Boolean.parseBoolean(System.getProperty(ENABLED, "false"))) {
+            return false;
+        }
+        Set<String> selected = preserved;
+        if (selected == null) {
+            synchronized (FailureTargetRegionPreservation.class) {
+                selected = preserved;
+                if (selected == null) {
+                    selected = readSkeletons();
+                    preserved = selected;
+                }
+            }
+        }
+        return selected.contains(regionId);
+    }
+
+    private static Set<String> readSkeletons() {
+        String configured = System.getProperty(SKELETONS, "").trim();
+        if (configured.isEmpty()) {
+            throw new IllegalStateException(ENABLED + " requires -D"
+                    + SKELETONS + " from the static region skeletons");
+        }
+        Path path = Paths.get(configured);
+        Set<String> selected = new LinkedHashSet<>();
+        try (InputStream file = Files.newInputStream(path);
+             InputStream bytes = configured.endsWith(".gz")
+                     ? new GZIPInputStream(file) : file;
+             BufferedReader rows = new BufferedReader(new InputStreamReader(
+                     bytes, StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = rows.readLine()) != null) {
+                if (line.trim().isEmpty()) continue;
+                JsonObject row = new JsonParser().parse(line)
+                        .getAsJsonObject();
+                if (!"REGION_SKELETON".equals(value(row, "kind"))) continue;
+                if ("FAILURE_TARGET_ENTRY".equals(value(row,
+                        "rootAuthority"))) {
+                    String region = value(row, "regionId");
+                    if (region.isEmpty() || !selected.add(region)) {
+                        throw new IllegalStateException("Invalid or duplicate"
+                                + " FAILURE_TARGET_ENTRY region in " + path
+                                + ": " + region);
+                    }
+                }
+            }
+        } catch (IOException | RuntimeException failed) {
+            throw new IllegalStateException("Cannot load static failure"
+                    + " target region skeletons from " + path, failed);
+        }
+        if (selected.isEmpty()) {
+            throw new IllegalStateException("No FAILURE_TARGET_ENTRY region"
+                    + " in static skeletons " + path);
+        }
+        return Collections.unmodifiableSet(selected);
+    }
+
+    private static String value(JsonObject row, String key) {
+        return row.has(key) && !row.get(key).isJsonNull()
+                ? row.get(key).getAsString() : "";
+    }
+
+    static void resetForTests() {
+        preserved = null;
+    }
+}
