+  /** Capture the actual reference returned by GETFIELD/GETSTATIC. */
+  public static void stateReadObject(Object owner, Object key, Object value, String site) {
+    if (value == null) { stateRead(owner, key, site); return; }
+    String ownerId;
+    String valueId;
+    String keyText = safeKey(key);
+    long version;
+    synchronized (STATE_LOCK) {
+      ownerId = objectId(owner);
+      valueId = objectId(value);
+      Long known = STATE_VERSIONS.get(ownerId + "|" + keyText);
+      version = known == null ? -1L : known.longValue();
+    }
+    event("STATE_READ", site, fields("object", ownerId, "key", keyText,
+        "version", version, "version_confidence", "sampled",
+        "value_object", valueId, "identity_kind", "reference_value"));
+  }
+
+  /** Capture the actual reference assigned by PUTFIELD/PUTSTATIC. */
+  public static void stateWriteObject(Object owner, Object key, Object value, String site) {
+    if (value == null) { stateWrite(owner, key, site); return; }
+    String ownerId;
+    String valueId;
+    String keyText = safeKey(key);
+    long version;
+    synchronized (STATE_LOCK) {
+      ownerId = objectId(owner);
+      valueId = objectId(value);
+      String location = ownerId + "|" + keyText;
+      Long old = STATE_VERSIONS.get(location);
+      version = old == null ? 1L : old.longValue() + 1L;
+      STATE_VERSIONS.put(location, version);
+    }
+    event("STATE_WRITE", site, fields("object", ownerId, "key", keyText,
+        "version", version, "version_confidence", "sampled",
+        "value_object", valueId, "identity_kind", "reference_value"));
   }
 
