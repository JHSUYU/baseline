+  /** Exact object identity captured from the actual GETFIELD/GETSTATIC result. */
+  public static void stateReadObject(Object owner, Object key, Object value, String site) {
+    if (value == null) { stateRead(owner, key, site); return; }
+    String ownerId;
+    String valueId;
+    synchronized (STATE_LOCK) {
+      ownerId = objectId(owner);
+      valueId = objectId(value);
+    }
+    event("STATE_READ", site, fields("object", ownerId, "key", safeKey(key),
+        "version", valueId, "value_object", valueId,
+        "version_confidence", "exact", "identity_kind", "reference_value"));
+  }
+
+  /** Exact object identity captured from the actual PUTFIELD/PUTSTATIC operand. */
+  public static void stateWriteObject(Object owner, Object key, Object value, String site) {
+    if (value == null) { stateWrite(owner, key, site); return; }
+    String ownerId;
+    String valueId;
+    synchronized (STATE_LOCK) {
+      ownerId = objectId(owner);
+      valueId = objectId(value);
+    }
+    event("STATE_WRITE", site, fields("object", ownerId, "key", safeKey(key),
+        "version", valueId, "value_object", valueId,
+        "version_confidence", "exact", "identity_kind", "reference_value"));
   }
 
