+  /** Request shape only: no host, query string, request body, or other parameters. */
+  public static MessageDoors.OperationScope operationScope(SolrRequest<?> request) {
+    if (!ENABLED || request == null)
+      return MessageDoors.operationScope(null, null, null);
+    try {
+      SolrParams params = request.getParams();
+      String action = params == null ? null : params.get("action");
+      return MessageDoors.operationScope(
+          request.getMethod() == null ? null : request.getMethod().name(),
+          request.getPath(), action);
+    } catch (RuntimeException unavailable) {
+      // Observability must not change the result of the original request.
+      return MessageDoors.operationScope(null, null, null);
+    }
+  }
