+package org.apache.solr.common.util;
+
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.function.Function;
+
+import edu.uva.liftlab.graphchecker.runtime.MessageDoors;
+
+/** Mallory transport boundary for SolrJ requests inside a test cluster. */
+public final class MalloryHttp {
+  public static final String TRACE = "X-Mallory-Trace";
+  public static final String SYMBOLIC = "X-Mallory-Symbolic";
+  public static final String CORRELATION = "X-Mallory-Correlation";
+  public static final String ATTEMPT = "X-Mallory-Attempt";
+  public static final String TRANSPORT = "X-Mallory-Transport";
+
+  private static final AtomicLong IDS = new AtomicLong();
+  private static final boolean ENABLED = Boolean.getBoolean("causynth.cluster.automatic");
+
+  private MalloryHttp() {}
+
+  public static MessageDoors.Outbound prepareRequest(String transport, Object owner) {
+    if (!ENABLED) return MessageDoors.outboundNone();
+    String correlation = "solr-" + IDS.incrementAndGet();
+    return MessageDoors.outbound(transport, correlation, "1",
+        MessageDoors.REQUEST, owner, null);
+  }
+
+  public static MessageDoors.Inbound receive(Function<String, String> header, Object owner) {
+    if (!ENABLED) return null;
+    String correlation = header.apply(CORRELATION);
+    if (correlation == null || correlation.isEmpty()) return null;
+    String transport = header.apply(TRANSPORT);
+    if (transport == null || transport.isEmpty()) transport = "SOLR_HTTP";
+    String attempt = header.apply(ATTEMPT);
+    if (attempt == null || attempt.isEmpty()) attempt = "1";
+    return MessageDoors.inbound(header.apply(TRACE), header.apply(SYMBOLIC),
+        transport, correlation, attempt, MessageDoors.REQUEST, owner, false);
+  }
+
+  public static void end(MessageDoors.Inbound inbound) {
+    if (inbound != null) MessageDoors.endInbound(inbound);
+  }
+
+}
