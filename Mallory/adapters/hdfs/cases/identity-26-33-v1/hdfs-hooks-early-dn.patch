+  /** Stage the concrete MiniDFSCluster config before its DN constructor starts actors. */
+  public static synchronized void dataNodeConstructionConfigured(Object cluster, Object conf) {
+    if (cluster == null || conf == null) return;
+    try {
+      Object existing = field(cluster, "dataNodes");
+      if (!(existing instanceof List<?>))
+        throw new IllegalStateException("MiniDFSCluster.dataNodes is not a list");
+      int index = ((List<?>) existing).size();
+      String prefix = CLUSTER_NAMES.get(cluster);
+      if (prefix == null) {
+        prefix = "hdfs-cluster-" + CLUSTERS.incrementAndGet();
+        CLUSTER_NAMES.put(cluster, prefix);
+      }
+      Map<Integer, Integer> epochs = DN_EPOCHS.get(cluster);
+      Integer previous = epochs == null ? null : epochs.get(index);
+      int epoch = previous == null ? 0 : previous + 1;
+      PendingDataNode pending = PENDING_DN_CONFIGS.get(conf);
+      if (pending != null) {
+        if (pending.cluster != cluster || pending.index != index)
+          throw new IllegalStateException("HDFS DataNode config reused for another actor");
+        return; // A constructor retry is still the same logical startup.
+      }
+      PENDING_DN_CONFIGS.put(conf, new PendingDataNode(
+          cluster, index, prefix + "/dn" + index, epoch));
+    } catch (ReflectiveOperationException failure) {
+      throw new IllegalStateException("HDFS DataNode construction config unavailable", failure);
+    }
+  }
+
+  /** Register storage before BlockPoolManager.refreshNamenodes starts BP actors. */
+  public static synchronized void dataNodeConstructionReady(Object dn) {
+    if (dn == null) return;
+    try {
+      PendingDataNode pending = PENDING_DN_CONFIGS.get(invoke(dn, "getConf"));
+      if (pending == null) return; // Non-MiniDFSCluster DataNode.
+      Probe.registerNode(dn, pending.node, pending.epoch);
+      register(field(dn, "storage"), pending.node, pending.epoch);
+      register(field(dn, "blockPoolManager"), pending.node, pending.epoch);
+      DN_OBJECT_EPOCHS.put(dn, pending.epoch);
+    } catch (ReflectiveOperationException failure) {
+      throw new IllegalStateException("HDFS early DataNode binding failed", failure);
+    }
+  }
