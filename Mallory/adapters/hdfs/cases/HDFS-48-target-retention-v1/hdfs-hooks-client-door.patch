+  /** Method-aware client RPC door, before serialization and queueing. */
+  public static void rpcBeforeSend(Object call) {
+    final Object request;
+    try {
+      request = field(call, "rpcRequest");
+    } catch (ReflectiveOperationException failure) {
+      throw new IllegalStateException("HDFS client RPC request unavailable", failure);
+    }
+    if (request == null || !request.getClass().getName().equals(
+        "org.apache.hadoop.ipc.ProtobufRpcEngine2$RpcProtobufRequest")) return;
+    String rpcName = request.toString();
+    String protocol = "org.apache.hadoop.hdfs.protocol.ClientProtocol.";
+    if (!rpcName.startsWith(protocol)) return;
+    String method = rpcName.substring(protocol.length());
+    if (method.isEmpty())
+      throw new IllegalStateException("HDFS client RPC method unavailable");
+    Probe.beforeDoor("hdfs:client-send-rpc-request:" + method,
+        "java.io.IOException");
+  }
