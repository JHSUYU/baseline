+package edu.uva.liftlab.mallory.adapters.hdfs;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+
+import edu.uva.liftlab.mallory.instrumentation.Probe;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.ClassWriter;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.AbstractInsnNode;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+public class Hdfs18HeartbeatBindingTest {
+  private static final String ACTOR = "org/apache/hadoop/hdfs/server/datanode/BPServiceActor";
+  private static final String HEARTBEAT =
+      "(Z)Lorg/apache/hadoop/hdfs/server/protocol/HeartbeatResponse;";
+
+  public static final class FakeActor {
+    private final Object dn;
+    FakeActor(Object dn) { this.dn = dn; }
+  }
+
+  @Test public void lateRegisteredDataNodeIsBoundAtHeartbeatEntry() {
+    Object dn = new Object();
+    FakeActor actor = new FakeActor(dn);
+    try (Probe.NodeScope ignored = Probe.withNode("unknown", 0)) {
+      try (Probe.NodeScope missing = HdfsHooks.serviceActorEnter(actor)) {
+        assertEquals("unknown", Probe.currentNode());
+      }
+      Probe.registerNode(dn, "hdfs-cluster-1/dn0", 0);
+      try (Probe.NodeScope bound = HdfsHooks.serviceActorEnter(actor)) {
+        assertEquals("hdfs-cluster-1/dn0", Probe.currentNode());
+      }
+      assertEquals("unknown", Probe.currentNode());
+    }
+  }
+
+  @Test public void heartbeatBytecodeRebindsAndClosesOnEveryExit() {
+    ClassWriter writer = new ClassWriter(0);
+    writer.visit(Opcodes.V1_8, Opcodes.ACC_PUBLIC, ACTOR, null, "java/lang/Object", null);
+    org.objectweb.asm.MethodVisitor method = writer.visitMethod(
+        Opcodes.ACC_PUBLIC, "sendHeartBeat", HEARTBEAT, null, null);
+    method.visitCode();
+    method.visitInsn(Opcodes.ACONST_NULL);
+    method.visitInsn(Opcodes.ARETURN);
+    method.visitMaxs(1, 2);
+    method.visitEnd();
+    writer.visitEnd();
+    byte[] rewritten = new HdfsMiniClusterTransformer().transform(
+        getClass().getClassLoader(), ACTOR, null, null, writer.toByteArray());
+    assertNotNull(rewritten);
+    ClassNode node = new ClassNode();
+    new ClassReader(rewritten).accept(node, 0);
+    List<String> calls = new ArrayList<String>();
+    for (MethodNode candidate : node.methods) {
+      if (!"sendHeartBeat".equals(candidate.name) || !HEARTBEAT.equals(candidate.desc)) continue;
+      for (AbstractInsnNode instruction : candidate.instructions.toArray()) {
+        if (instruction instanceof MethodInsnNode)
+          calls.add(((MethodInsnNode) instruction).name);
+      }
+    }
+    assertTrue(calls.contains("serviceActorEnter"));
+    assertTrue(calls.contains("close"));
+  }
+}
