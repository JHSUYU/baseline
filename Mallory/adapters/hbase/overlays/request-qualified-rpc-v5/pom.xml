  <dependencies>
    <dependency><groupId>edu.uva.liftlab.mallory</groupId><artifactId>mallory-instrumentation</artifactId><version>1.0-SNAPSHOT</version><scope>system</scope><systemPath>/users/ZhenyuLi/baseline/Mallory/instrumentation/releases/159c74ec50d0703e85cfdfd1b06451e961fc180db04d568926b990aa5458db7a/mallory-agent.jar</systemPath></dependency>
    <dependency><groupId>org.ow2.asm</groupId><artifactId>asm</artifactId><version>9.6</version></dependency>
    <dependency><groupId>org.ow2.asm</groupId><artifactId>asm-tree</artifactId><version>9.6</version></dependency>
    <dependency><groupId>org.ow2.asm</groupId><artifactId>asm-util</artifactId><version>9.6</version></dependency>
