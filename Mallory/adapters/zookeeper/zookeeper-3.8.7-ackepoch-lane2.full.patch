+package org.apache.zookeeper.server.quorum;
+
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.lang.reflect.Field;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.net.Socket;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayDeque;
+import java.util.Map;
+import java.util.WeakHashMap;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+import org.apache.jute.BinaryInputArchive;
+import org.apache.jute.BinaryOutputArchive;
+import org.apache.jute.Record;
+import org.apache.zookeeper.server.Request;
+
+/** Minimal quorum adapter. Installed only in an isolated test source tree. */
+public final class MalloryZkHooks {
+    private static final String PROBE = "edu.uva.liftlab.mallory.instrumentation.Probe";
+    private static final String TRANSPORT = "zookeeper-quorum-tcp";
+    private static final String READ_DOOR = "zookeeper.quorum.archive.readRecord";
+    private static final String CLIENT_READ_DOOR = "zookeeper.client.request.read";
+    private static final String CLIENT_CONNECT_DOOR = "zookeeper.client.connect.read";
+    private static final String WRITE_DOOR = "zookeeper.quorum.archive.writeRecord";
+    private static final Map<Long, AtomicInteger> EPOCHS = new ConcurrentHashMap<>();
+    private static final Map<Socket, Counts> COUNTS = new WeakHashMap<>();
+    private static final Map<Request, ArrayDeque<String>> TASK_TOKENS = new WeakHashMap<>();
+    private static final AtomicLong NEXT_TASK = new AtomicLong();
+    private static final AtomicLong NEXT_CLIENT = new AtomicLong();
+    private static final ThreadLocal<ReceivedPacket> LAST_RECEIVED = new ThreadLocal<>();
+
+    private MalloryZkHooks() { }
+
+    static void startPeer(QuorumPeer peer) {
+        EPOCHS.computeIfAbsent(peer.getMyId(), ignored -> new AtomicInteger(-1)).incrementAndGet();
+        node(peer.getMyId());
+    }
+
+    public static void node(long sid) {
+        // A failed owner lookup must remain unknown, never become a named zk-1.
+        if (sid < 0) return;
+        AtomicInteger epoch = EPOCHS.get(sid);
+        call("setNode", new Class<?>[] {String.class, int.class}, "zk" + sid,
+             epoch == null ? 0 : epoch.get());
+    }
+
+    /** Bind a tracker receiver to its peer's actual lifecycle epoch. */
+    public static void registerTracker(Object tracker, long sid) {
+        if (tracker == null || sid < 0) return;
+        AtomicInteger epoch = EPOCHS.get(sid);
+        call("registerNode",
+             new Class<?>[] {Object.class, String.class, int.class},
+             tracker, "zk" + sid, epoch == null ? 0 : epoch.get());
+    }
+
+    public static void registerPeerReceiver(Object receiver, long sid) {
+        registerTracker(receiver, sid);
+    }
+
+    static long masterId(LearnerMaster master) {
+        if (master instanceof Leader) return ((Leader) master).self.getMyId();
+        try {
+            Field field = master.getClass().getDeclaredField("self");
+            field.setAccessible(true);
+            return ((QuorumPeer) field.get(master)).getMyId();
+        } catch (ReflectiveOperationException | SecurityException unavailable) {
+            return -1;
+        }
+    }
+
+    static BinaryInputArchive input(InputStream stream, Socket socket, long sid) {
+        return new Input(new DataInputStream(stream), socket, sid);
+    }
+
+    static BinaryOutputArchive output(OutputStream stream, Socket socket, long sid) {
+        return new Output(new DataOutputStream(stream), socket, sid);
+    }
+
+    /** Keep the parsed client packet's identity until its request is queued. */
+    /** Correlate a decoded ConnectRequest with its queued create-session request. */
+    public static Scope connectRequestScope(long sid, long sessionId) throws IOException {
+        node(sid);
+        String token = "zk-connect:" + sid + ":" + Long.toHexString(sessionId) + ":"
+                       + NEXT_CLIENT.incrementAndGet();
+        Object context = invoke("receiveScope",
+            new Class<?>[] {String.class, String.class, String.class, String.class},
+            "zookeeper-client", token, sessionId == 0 ? "new-session" : "renew-session",
+            CLIENT_CONNECT_DOOR);
+        Scope scope = new Scope(context instanceof AutoCloseable ? (AutoCloseable) context : null);
+        try {
+            beforeDoor(CLIENT_CONNECT_DOOR);
+            return scope;
+        } catch (IOException | RuntimeException | Error failure) {
+            scope.close();
+            throw failure;
+        }
+    }
+
+    public static Scope clientRequestScope(long sid, long sessionId, int xid, int opcode) throws IOException {
+        node(sid);
+        String token = "zk-client:" + sid + ":" + Long.toHexString(sessionId) + ":"
+                       + xid + ":" + NEXT_CLIENT.incrementAndGet();
+        Object context = invoke("receiveScope",
+            new Class<?>[] {String.class, String.class, String.class, String.class},
+            "zookeeper-client", token, "opcode:" + opcode, CLIENT_READ_DOOR);
+        Scope scope = new Scope(context instanceof AutoCloseable ? (AutoCloseable) context : null);
+        try {
+            beforeDoor(CLIENT_READ_DOOR);
+            return scope;
+        } catch (IOException | RuntimeException | Error failure) {
+            scope.close();
+            throw failure;
+        }
+    }
+
+    public static void submit(Request request, long sid, String site) {
+        if (request == null || request == Request.requestOfDeath) return;
+        node(sid);
+        String token = "zk-request:" + sid + ":" + NEXT_TASK.incrementAndGet();
+        synchronized (TASK_TOKENS) {
+            ArrayDeque<String> queue = TASK_TOKENS.get(request);
+            if (queue == null) { queue = new ArrayDeque<>(); TASK_TOKENS.put(request, queue); }
+            queue.addLast(token);
+        }
+        call("taskSubmit", new Class<?>[] {String.class, String.class}, token, site);
+    }
+
+    public static Scope claim(Request request, long sid, String site) {
+        node(sid);
+        String token = null;
+        synchronized (TASK_TOKENS) {
+            ArrayDeque<String> queue = TASK_TOKENS.get(request);
+            if (queue != null) {
+                token = queue.pollFirst();
+                if (queue.isEmpty()) TASK_TOKENS.remove(request);
+            }
+        }
+        Object context = invoke("taskClaim", new Class<?>[] {String.class, String.class}, token, site);
+        return new Scope(context instanceof AutoCloseable ? (AutoCloseable) context : null);
+    }
+
+    public static final class Scope implements AutoCloseable {
+        private final AutoCloseable context;
+        private final String region;
+        private Scope(AutoCloseable context) { this(context, null); }
+        private Scope(AutoCloseable context, String region) {
+            this.context = context;
+            this.region = region;
+        }
+        @Override public void close() {
+            try {
+                if (region != null) call("regionExit", new Class<?>[] {String.class}, region);
+            } finally {
+                if (context != null) {
+                    try { context.close(); }
+                    catch (Exception failure) { throw new IllegalStateException("Mallory scope", failure); }
+                }
+            }
+        }
+    }
+
+    private static final class ReceivedPacket {
+        final QuorumPacket packet;
+        final String correlation;
+        ReceivedPacket(QuorumPacket packet, String correlation) {
+            this.packet = packet;
+            this.correlation = correlation;
+        }
+    }
+
+    private static final class Counts {
+        long sent;
+        long received;
+    }
+
+    private static String correlation(Socket socket, QuorumPacket packet, boolean sending) {
+        if (socket == null || !socket.isConnected()) return null;
+        String local = socket.getLocalAddress().getHostAddress() + ":" + socket.getLocalPort();
+        String remote = socket.getInetAddress().getHostAddress() + ":" + socket.getPort();
+        String direction = sending ? local + ">" + remote : remote + ">" + local;
+        long ordinal;
+        synchronized (COUNTS) {
+            Counts counts = COUNTS.get(socket);
+            if (counts == null) { counts = new Counts(); COUNTS.put(socket, counts); }
+            ordinal = sending ? ++counts.sent : ++counts.received;
+        }
+        return direction + "#" + ordinal + ":" + packet.getType() + ":" + packet.getZxid();
+    }
+
+    private static String requestDigest(byte[] bytes) {
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-256").digest(bytes);
+            final char[] alphabet = "0123456789abcdef".toCharArray();
+            char[] hex = new char[digest.length * 2];
+            for (int i = 0; i < digest.length; i++) {
+                hex[2 * i] = alphabet[(digest[i] >>> 4) & 15];
+                hex[2 * i + 1] = alphabet[digest[i] & 15];
+            }
+            return new String(hex);
+        } catch (NoSuchAlgorithmException impossible) {
+            throw new IllegalStateException(impossible);
+        }
+    }
+
+    private static void packet(Socket socket, long sid, Record record, boolean sending) {
+        if (!(record instanceof QuorumPacket)) return;
+        node(sid);
+        QuorumPacket packet = (QuorumPacket) record;
+        String correlation = correlation(socket, packet, sending);
+        if (correlation == null) return;
+        String port = packet.getType() == Leader.REQUEST
+            ? "REQUEST:" + requestDigest(packet.getData())
+            : packet.getType() + ":" + packet.getZxid();
+        if (!sending) {
+            if (packet.getType() == Leader.REQUEST
+                || packet.getType() == Leader.ACKEPOCH)
+                LAST_RECEIVED.set(new ReceivedPacket(packet, correlation));
+            else LAST_RECEIVED.remove();
+        }
+        call(sending ? "send" : "receive",
+             new Class<?>[] {String.class, String.class, String.class, String.class},
+             TRANSPORT, correlation, port, sending ? WRITE_DOOR : READ_DOOR);
+    }
+
+    /** Continue only from the exact ACKEPOCH object read on this thread. */
+    public static Scope quorumAckEpochScope(QuorumPacket packet, long masterId) {
+        node(masterId);
+        ReceivedPacket received = LAST_RECEIVED.get();
+        LAST_RECEIVED.remove();
+        if (packet.getType() != Leader.ACKEPOCH || received == null
+            || received.packet != packet) return new Scope(null);
+        Object context = invoke("withCausalContext",
+            new Class<?>[] {String.class}, received.correlation);
+        AutoCloseable scope = context instanceof AutoCloseable ? (AutoCloseable) context : null;
+        String region = "zookeeper.leader.ackepoch";
+        try {
+            call("regionEnter", new Class<?>[] {String.class}, region);
+            return new Scope(scope, region);
+        } catch (RuntimeException | Error failure) {
+            if (scope != null) {
+                try { scope.close(); } catch (Exception closeFailure) { failure.addSuppressed(closeFailure); }
+            }
+            throw failure;
+        }
+    }
+
+    /** Continue from the exact QuorumPacket read into the leader's request queue. */
+    public static Scope quorumRequestScope(QuorumPacket packet, long sid) {
+        node(sid);
+        ReceivedPacket received = LAST_RECEIVED.get();
+        LAST_RECEIVED.remove();
+        if (received == null || received.packet != packet) return new Scope(null);
+        Object context = invoke("withCausalContext",
+            new Class<?>[] {String.class}, received.correlation);
+        AutoCloseable scope = context instanceof AutoCloseable ? (AutoCloseable) context : null;
+        String region = "zookeeper.leader.request";
+        try {
+            call("regionEnter", new Class<?>[] {String.class}, region);
+            return new Scope(scope, region);
+        } catch (RuntimeException | Error failure) {
+            if (scope != null) {
+                try { scope.close(); } catch (Exception closeFailure) { failure.addSuppressed(closeFailure); }
+            }
+            throw failure;
+        }
+    }
+
+    private static void beforeDoor(String site) throws IOException {
+        try {
+            Class<?> probe = Class.forName(PROBE);
+            probe.getMethod("beforeDoor", String.class).invoke(null, site);
+        } catch (ClassNotFoundException absent) {
+            // A plain ZooKeeper build remains runnable without the Mallory agent.
+        } catch (InvocationTargetException injected) {
