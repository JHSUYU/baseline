+  @Test public void resourceBoundReplayFailsClosedAcrossOrdinalDrift() throws Exception {
+    FaultPlan plan = new FaultPlan();
+    FaultPlan.Fault fault = new FaultPlan.Fault();
+    fault.fault_id = "bound-resource";
+    fault.fault_type = "EXCEPTION";
+    fault.point = new FaultPlan.Point();
+    fault.point.site = "zk:exists";
+    fault.point.node = "solr-node";
+    fault.point.epoch = 0;
+    fault.point.door_ordinal = 1L;
+    fault.point.resource = "/live_nodes/expected";
+    plan.faults.add(fault);
+    File drifted = File.createTempFile("mallory-resource-drift", ".jsonl");
+    Probe.install("resource-drift", drifted, plan);
+    try (Probe.NodeScope node = Probe.withNode("solr-node", 0)) {
+      Probe.beforeDoor("zk:exists", "java.io.IOException", "/overseer/queue");
+      Probe.beforeDoor("zk:exists", "java.io.IOException", "/live_nodes/expected");
+    }
+    assertFalse("wrong path at ordinal one cannot consume the plan",
+        hasType(readEvents(drifted), "FAULT_APPLIED"));
+    assertEquals("/overseer/queue",
+        firstType(readEvents(drifted), "DOOR_OBSERVED").get("resource").getAsString());
+
+    File exact = File.createTempFile("mallory-resource-exact", ".jsonl");
+    Probe.install("resource-exact", exact, plan);
+    try (Probe.NodeScope node = Probe.withNode("solr-node", 0)) {
+      Probe.beforeDoor("zk:exists", "java.io.IOException", "/live_nodes/expected");
+      fail("exact resource and ordinal must inject");
+    } catch (Throwable expected) {
+      assertEquals(java.io.IOException.class, expected.getClass());
+    }
+    assertEquals("/live_nodes/expected",
+        firstType(readEvents(exact), "FAULT_APPLIED").get("resource").getAsString());
+
+    // Existing resource-free plans keep their old matching semantics.
+    FaultPlan legacyPlan = new FaultPlan();
+    FaultPlan.Fault legacyFault = new FaultPlan.Fault();
+    legacyFault.fault_id = "legacy-resource-free";
+    legacyFault.fault_type = "EXCEPTION";
+    legacyFault.point = new FaultPlan.Point();
+    legacyFault.point.site = "zk:exists";
+    legacyFault.point.node = "solr-node";
+    legacyFault.point.epoch = 0;
+    legacyFault.point.door_ordinal = 1L;
+    legacyPlan.faults.add(legacyFault);
+    File legacy = File.createTempFile("mallory-resource-legacy", ".jsonl");
+    Probe.install("resource-legacy", legacy, legacyPlan);
+    try (Probe.NodeScope node = Probe.withNode("solr-node", 0)) {
+      Probe.beforeDoor("zk:exists", "java.io.IOException", "/overseer/queue");
+      fail("legacy point should still match the first ordinal");
+    } catch (Throwable expected) {
+      assertEquals(java.io.IOException.class, expected.getClass());
+    }
