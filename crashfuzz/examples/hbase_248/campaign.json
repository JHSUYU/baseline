{
  "target": {
    "site": "org/apache/hadoop/hbase/master/HMaster#checkTableModifiable(Lorg/apache/hadoop/hbase/TableName;)V#B2"
  },
  "output_dir": "out",
  "controller": {"bind": "0.0.0.0", "advertise": "host.docker.internal", "port": 0},
  "roles": {"hm1": "master", "hm2": "master", "rs1": "regionserver",
            "rs2": "regionserver", "rs3": "regionserver", "client": "client"},
  "node_groups": [
    {"members": ["hm1", "hm2"], "max_down": 1},
    {"members": ["rs1", "rs2", "rs3"], "max_down": 2}
  ],
  "docker": {
    "command": ["sudo", "-n", "docker"],
    "containers": {
      "hm1": "adhocfuzz-hbase-hm1", "hm2": "adhocfuzz-hbase-hm2",
      "rs1": "adhocfuzz-hbase-rs1", "rs2": "adhocfuzz-hbase-rs2",
      "rs3": "adhocfuzz-hbase-rs3"
    },
    "prepare": ["python3", "prepare.py"],
    "workload": ["python3", "workload.py"],
    "checker": ["python3", "checker.py"],
    "workload_timeout_s": 300,
    "command_timeout_s": 240
  },
  "search": {"max_runs": 2, "max_faults": 1,
             "max_candidates_per_run": 30,
             "exploration_probability": 0.15, "replay_count": 1}
}
