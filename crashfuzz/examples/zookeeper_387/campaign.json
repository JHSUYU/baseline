{
  "target": {"site": "discovery#TARGET"},
  "output_dir": "out",
  "controller": {"bind": "0.0.0.0", "advertise": "host.docker.internal", "port": 0},
  "roles": {"zk1": "server", "zk2": "server", "zk3": "server", "client": "client"},
  "node_groups": [
    {"members": ["zk1", "zk2", "zk3"], "max_down": 1}
  ],
  "docker": {
    "command": ["sudo", "-n", "docker"],
    "containers": {
      "zk1": "adhocfuzz-zk387-zk1",
      "zk2": "adhocfuzz-zk387-zk2",
      "zk3": "adhocfuzz-zk387-zk3"
    },
    "prepare": ["python3", "prepare.py"],
    "workload": ["python3", "workload.py"],
    "checker": ["python3", "checker.py"],
    "workload_timeout_s": 240,
    "command_timeout_s": 150
  },
  "search": {"max_runs": 4, "max_faults": 2,
             "max_candidates_per_run": 100,
             "exploration_probability": 0.2, "replay_count": 2}
}
