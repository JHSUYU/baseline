{
  "target": {"site": "example/tiny/Node#responseCheck", "node": "b"},
  "output_dir": "out",
  "controller": {"bind": "0.0.0.0", "advertise": "host.docker.internal", "port": 0},
  "roles": {"a": "server", "b": "client"},
  "node_groups": [{"members": ["a", "b"], "max_down": 1}],
  "docker": {
    "command": ["sudo", "-n", "docker"],
    "containers": {"a": "adhocfuzz-tiny-a", "b": "adhocfuzz-tiny-b"},
    "prepare": ["python3", "prepare.py"],
    "workload": ["python3", "workload.py"],
    "checker": ["python3", "checker.py"],
    "workload_timeout_s": 30,
    "command_timeout_s": 60
  },
  "search": {
    "max_runs": 8,
    "max_faults": 2,
    "max_candidates_per_run": 50,
    "exploration_probability": 0.15,
    "replay_count": 1,
    "random_seed": 2
  }
}
